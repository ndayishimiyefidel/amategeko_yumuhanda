# Exclude asset binaries and large files
assets/*.png
assets/*.jpg
assets/*.jpeg
assets/*.pdf
assets/*.exe
assets/*.mp4
assets/*.mov
assets/*.avi
assets/*.zip
assets/*.tar.gz
assets/*.7z
assets/*.svg
assets/*.ttf
assets/*.otf

# Exclude asset subfolders with images and binaries
assets/examimages/
assets/icons/
assets/images/
assets/files/*.pdf
assets/files/*.json
assets/fonts/

# Firebase/Google services
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

